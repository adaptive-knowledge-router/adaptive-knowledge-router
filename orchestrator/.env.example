# Orchestrator environment variables (all optional — defaults work in Docker Compose).
# Prefix: ORCH_

# Downstream service URLs
ORCH_ROUTER_URL=http://router-service:8001
ORCH_KG_URL=http://kg-service:8000
ORCH_RAG_URL=http://rag-service:8002

# HTTP client settings
ORCH_REQUEST_TIMEOUT=120.0
ORCH_MAX_RETRIES=2

# Router confidence threshold (0.0–1.0)
ORCH_CONFIDENCE_THRESHOLD=0.4

# Default number of results from RAG endpoints
ORCH_DEFAULT_TOP_K=5
